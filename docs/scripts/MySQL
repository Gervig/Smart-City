CREATE TABLE `Citizen` (
  `id (PK)` <type>,
  `first_name` <type>,
  `last_name` <type>,
  `birth_date` <type>,
  `death_date (NULLABLE)` <type>,
  `status (alive / dead)` <type>,
  `gender` <type>,
  `age` <type>,
  `family_id (FK)` <type>,
  `housing_id (FK)` <type>,
  KEY `Long` (`id (PK)`),
  KEY `String` (`first_name`, `last_name`, `status (alive / dead)`, `gender`),
  KEY `date` (`birth_date`, `death_date (NULLABLE)`),
  KEY `int` (`age`),
  KEY `long` (`housing_id (FK)`)
);

CREATE TABLE `Company` (
  `id (PK)` <type>,
  `location_id (FK)` <type>,
  `name` <type>,
  `founded_date` <type>,
  `dissolved_date (NULLABLE)` <type>,
  `status (active / dissolved)` <type>,
  KEY `Long` (`id (PK)`, `location_id (FK)`),
  KEY `String` (`name`, `status (active / dissolved)`),
  KEY `date` (`founded_date`, `dissolved_date (NULLABLE)`)
);

CREATE TABLE `Job` (
  `id (PK)` <type>,
  `citizen_id (FK)` <type>,
  `company_id (FK)` <type>,
  `institution_id (FK)` <type>,
  `title` <type>,
  `salary` <type>,
  `start_date` <type>,
  `end_date (NULLABLE)` <type>,
  `status (active / inactive)` <type>,
  FOREIGN KEY (`title`)
      REFERENCES `Company`(`founded_date`),
  KEY `Long` (`id (PK)`, `citizen_id (FK)`, `company_id (FK)`, `institution_id (FK)`),
  KEY `String` (`title`),
  KEY `numeric` (`salary`),
  KEY `date` (`start_date`, `end_date (NULLABLE)`),
  KEY `string` (`status (active / inactive)`)
);

CREATE TABLE `Family` (
  `id (PK)` <type>,
  `family_name` <type>,
  KEY `Long` (`id (PK)`),
  KEY `String` (`family_name`)
);

CREATE TABLE `Citizen_Relationship` (
  `id (PK)` <type>,
  `citizen_id_1 (FK)` <type>,
  `citizen_id_2 (FK)` <type>,
  `relationship_type (parent / child / marriage)` <type>,
  `start_date` <type>,
  `end_date (NULLABLE)` <type>,
  FOREIGN KEY (`citizen_id_2 (FK)`)
      REFERENCES `Citizen`(`death_date (NULLABLE)`),
  KEY `Long` (`id (PK)`, `citizen_id_1 (FK)`, `citizen_id_2 (FK)`),
  KEY `string` (`relationship_type (parent / child / marriage)`),
  KEY `date` (`start_date`, `end_date (NULLABLE)`)
);

CREATE TABLE `Location` (
  `id (PK)` <type>,
  `name` <type>,
  `street_address` <type>,
  KEY `Long` (`id (PK)`),
  KEY `string` (`name`, `street_address`)
);

CREATE TABLE `Housing` (
  `id (PK)` <type>,
  `location_id (FK)` <type>,
  `housing_type (house, appartment)` <type>,
  `capacity` <type>,
  `` <type>,
  FOREIGN KEY (`housing_type (house, appartment)`)
      REFERENCES `Location`(`name`),
  KEY `Long` (`id (PK)`, `location_id (FK)`),
  KEY `String` (`housing_type (house, appartment)`),
  KEY `int` (`capacity`)
);

CREATE TABLE `Institution` (
  `id (PK)` <type>,
  `location_id (FK)` <type>,
  `name` <type>,
  `type (High School, College, Hospital)` <type>,
  KEY `Long` (`id (PK)`, `location_id (FK)`),
  KEY `string` (`name`, `type (High School, College, Hospital)`)
);

CREATE TABLE `Education_Record` (
  `id(Pk)` <type>,
  `citizen_id(FK)` <type>,
  `institution_id (FK)` <type>,
  `start_date` <type>,
  `end_date (NULLABLE)` <type>,
  FOREIGN KEY (`institution_id (FK)`)
      REFERENCES `Institution`(`type (High School, College, Hospital)`),
  FOREIGN KEY (`institution_id (FK)`)
      REFERENCES `Citizen`(`status (alive / dead)`),
  KEY `Long` (`id(Pk)`, `citizen_id(FK)`, `institution_id (FK)`),
  KEY `Date` (`start_date`, `end_date (NULLABLE)`)
);

